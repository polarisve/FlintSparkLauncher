BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "polarisve"
            VALUE "FileDescription", "Flint Spark Launcher"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "Flint Spark Launcher.exe"
            VALUE "LegalCopyright", "Copyright (C) 2026 polarisve. Based on HMCL, Copyright (C) huangyuhui and contributors, GPL v3"
            VALUE "OriginalFilename", "Flint Spark Launcher.exe"
            VALUE "ProductName", "Flint Spark Launcher"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END


